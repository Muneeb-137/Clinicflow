# Copy to .env and fill in real values. Never commit .env.

# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PATIENT_JWT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The web app's origin. Used for CORS and email links.
CLIENT_URL=http://localhost:5173

DB_USER=postgres
DB_HOST=localhost
DB_NAME=clinicflow
DB_PASSWORD=
DB_PORT=5433

# Dev only: set to true if antivirus or a proxy intercepts SMTP TLS
# ("self-signed certificate in certificate chain"). Never in production.
SMTP_ALLOW_SELF_SIGNED=false

# Inbox that receives Contact page messages (defaults to SMTP_USER).
CONTACT_EMAIL=

# Clinic time zone for "today" and clock times (default America/Toronto).
CLINIC_TIME_ZONE=America/Toronto

# Number of examination rooms (same as VITE_EXAM_ROOM_COUNT in clinicflow-web).
EXAM_ROOM_COUNT=6

# Development only: print two-step sign-in codes in the server log
# instead of emailing them. Never set this in production.
LOG_LOGIN_CODES=false

# Clinic name used in text messages.
CLINIC_NAME=ClinicFlow

# Patients can reschedule online until this many hours before a visit.
RESCHEDULE_CUTOFF_HOURS=2

# Text messages (Twilio). Leave empty to write texts to the server log instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number (+1...) or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public address of this API, so Twilio's STOP/START webhook signature can be
# checked (e.g. https://api.yourclinic.ca). Webhook path:
# /api/patient-profile/sms/inbound
PUBLIC_API_URL=
